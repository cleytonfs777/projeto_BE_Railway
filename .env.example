# Credenciais do sistema BE (Selenium)
USER_BE=seu_usuario_be
PASSWORD_BE=sua_senha_be
URL_BE=https://exemplo.com/caminho-do-sistema

# Sessão da API FastAPI (gere um valor aleatório forte)
# Ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_um_valor_aleatorio_longo

# Usuário admin criado na 1ª inicialização do banco (produção)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha_forte

# Opcional: caminho do SQLite (no Railway use volume, ex.: /data/app.db)
# DB_PATH=/data/app.db

# Já definidos no Dockerfile; só sobrescreva se necessário
# CHROME_BIN=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver

SE_COMPRA=2